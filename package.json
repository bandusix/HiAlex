{
  "name": "hialex",
  "version": "0.1.0",
  "description": "GUI installer for Paseo and Claude CLI",
  "main": "installer/main.js",
  "scripts": {
    "start": "electron installer/main.js",
    "build": "npm run build:installer",
    "build:installer": "cd installer && npm run build",
    "package:win": "electron-builder --win",
    "package:mac": "electron-builder --mac",
    "package:all": "electron-builder --win --mac",
    "dev": "electron installer/main.js --dev"
  },
  "keywords": [
    "paseo",
    "claude",
    "installer",
    "ai",
    "coding-assistant"
  ],
  "author": "HiAlex Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "decompress": "^4.2.1",
    "electron-store": "^8.1.0",
    "node-fetch": "^3.3.2"
  },
  "build": {
    "appId": "com.hialex.installer",
    "productName": "HiAlex",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "installer/**/*",
      "resources/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "resources/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "resources/icon.icns",
      "category": "public.app-category.developer-tools"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
